# ---------------------------------------------------------------------------
# KAIA platform configuration. Copy to .env and replace every secret.
# ---------------------------------------------------------------------------

ENVIRONMENT=development            # development | staging | production

# Database (docker compose builds DATABASE_URL from POSTGRES_PASSWORD automatically)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://kaia:change-me@localhost:5432/kaia

# Authentication
JWT_SECRET=replace-with-64-random-characters
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false                # set true when served over HTTPS
LOGIN_RATE_LIMIT_PER_5MIN=10

# Field-level encryption for names, birth dates, contact details and clinical notes.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotate by prepending a new key: FIELD_ENCRYPTION_KEY=newkey,oldkey
FIELD_ENCRYPTION_KEY=replace-with-fernet-key

# Signed, expiring URLs for assay images
FILE_URL_SECRET=replace-with-random-secret
FILE_URL_TTL_SECONDS=300

# Web
CORS_ORIGINS=["http://localhost:5173"]
PUBLIC_APP_URL=http://localhost:5173
TIMEZONE=Asia/Manila

# Storage & simulation
STORAGE_BACKEND=local
MEDIA_ROOT=./media
READER_STAGE_SECONDS=1.4           # duration of each simulated KAIA Reader stage
ENABLE_DEMO_ENDPOINTS=true         # /api/admin/demo/reset (always disabled in production)

# Frontend (Vite)
VITE_DEMO_MODE=true                # show the in-app demo guide & demo account shortcuts
